# Ví dụ cấu hình môi trường cho Extension (Chỉ dùng cho tham khảo cục bộ khi debug)
# KHÔNG LƯU API KEY THẬT VÀO FILE NÀY!
# Khóa API thật phải được lưu trữ trong SecretStorage thông qua lệnh "NesCode: Configure Connection".

# Địa chỉ URL của Worker (môi trường dev cục bộ hoặc production HTTPS)
NESCODE_API_BASE_URL="http://localhost:8787"

# Chế độ debug mở rộng (không in payload mã nguồn)
NESCODE_DEBUG="false"
